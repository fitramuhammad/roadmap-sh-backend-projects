<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="JWT_SECRET" value="test_jwt_secret_key_for_testing_purposes_1234567890"/>
        <env name="JWT_REFRESH_SECRET" value="test_jwt_refresh_secret_key_for_testing_purposes_1234567890"/>
        <env name="DB_HOST" value="localhost"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_NAME" value="todo_test"/>
        <env name="DB_USER" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
    </php>
</phpunit>
